SPOTIPY_CLIENT_ID=your_spotify_client_id
SPOTIPY_CLIENT_SECRET=your_spotify_client_secret
SPOTIPY_REDIRECT_URI=http://127.0.0.1:8888/callback
# Set to 1 only for local mock testing.
MUSIC_TEST_MODE=0

# Delay lyrics when the lyric source appears early. Value is milliseconds.
LYRICS_DELAY_MS= 0
# Delay between lyric characters. Value is seconds.
CHARACTER_DELAY_SECONDS=0.10
